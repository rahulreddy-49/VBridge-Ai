# ==============================================================================
# AI Medical Literature & Clinical Decision Support Simulator - Environment Template
# ==============================================================================

# Server & Database Settings
PORT=8080
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=medlit_ai
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/medlit_ai?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Port mappings for Docker Compose
FRONTEND_PORT=5173
BACKEND_PORT=8080
MYSQL_PORT=3306

# Simulator Mode
DEMO_MODE=true

# Optional External AI Service API Keys (Optional - Simulator functions out-of-the-box in Demo Mode)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend Configuration (When running locally outside Docker)
VITE_API_BASE_URL=http://localhost:8080/api
